rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // PROTOTIPO (entorno de prueba gratuito): acceso abierto.
    // Para producción, restringe por autenticación: if request.auth != null;
    match /prestaciones/{id} {
      allow read, write: if true;
    }
    match /liquidaciones/{id} {
      allow read, write: if true;
    }
    match /profesionales/{id} {
      allow read, write: if true;
    }
    match /historial/{id} {
      allow read, write: if true;
    }
    match /tipos/{id} {
      allow read, write: if true;
    }
    match /sedes/{id} {
      allow read, write: if true;
    }
    match /especialidades/{id} {
      allow read, write: if true;
    }
    match /usuarios/{id} {
      allow read, write: if true;
    }
    match /apsorad_prestaciones/{id} {
      allow read, write: if true;
    }
    match /apsorad_liquidaciones/{id} {
      allow read, write: if true;
    }
    match /apsorad_historial/{id} {
      allow read, write: if true;
    }
  }
}
